###########################################################################
# Eye HMS SaaS — Environment Configuration
# Copy this file to .env and update all values before running the app.
# NEVER commit the actual .env file to version control!
###########################################################################

# ──────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────
APP_NAME="Eye HMS SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Default tenant_id context (0 = superadmin / no tenant)
APP_TENANT_ID=0

BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────────────
# Database — MySQL 8.0
# ──────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eye_hms_saas
DB_USERNAME=root
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Session / Cache / Queue — Redis
# ──────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ──────────────────────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# ──────────────────────────────────────────────────────────────────────────
# Mail
# ──────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@eyehms.com"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────────────
# Razorpay Payment Gateway
# ──────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Platform / SuperAdmin
# ──────────────────────────────────────────────────────────────────────────
PLATFORM_NAME="Eye HMS SaaS"
PLATFORM_SUPPORT_EMAIL=support@eyehms.com

# Seeder credentials — CHANGE IMMEDIATELY AFTER FIRST LOGIN
SUPERADMIN_EMAIL=superadmin@eyehms.com
SUPERADMIN_PASSWORD=SuperAdmin@123!
SUPERADMIN_NAME="Super Admin"

# ──────────────────────────────────────────────────────────────────────────
# Subscription Configuration
# ──────────────────────────────────────────────────────────────────────────
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=7

# ──────────────────────────────────────────────────────────────────────────
# Sanctum (API)
# ──────────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ──────────────────────────────────────────────────────────────────────────
# Laravel Telescope (Dev only — disable in production)
# ──────────────────────────────────────────────────────────────────────────
TELESCOPE_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────
# AWS (not used — kept for Laravel defaults)
# ──────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
